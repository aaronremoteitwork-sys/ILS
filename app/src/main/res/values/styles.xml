<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher plate only. Screen colors live in Ui.java; these themes mirror that palette
         for the action bar, status bar, menus, and dialogs. -->
    <color name="ic_bg">#1F3A5F</color>

    <style name="AppTheme" parent="@android:style/Theme.Material.Light">
        <item name="android:colorPrimary">#1E6FD9</item>
        <item name="android:colorPrimaryDark">#FFFFFF</item>
        <item name="android:colorAccent">#1E6FD9</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:textColorPrimary">#1B1F24</item>
        <item name="android:textColorSecondary">#5E6A75</item>
        <item name="android:textColorHint">#5E6A75</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:actionBarStyle">@style/IlsBar.Light</item>
        <item name="android:actionMenuTextColor">#1B1F24</item>
        <item name="android:alertDialogTheme">@style/IlsDialog.Light</item>
        <item name="android:popupMenuStyle">@style/IlsPopup.Light</item>
        <item name="android:actionOverflowMenuStyle">@style/IlsOverflow.Light</item>
        <item name="android:textAppearanceLargePopupMenu">@style/IlsPopupText.Light</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/IlsPopupText.Light</item>
    </style>

    <style name="AppTheme.Dark" parent="@android:style/Theme.Material">
        <item name="android:colorPrimary">#1E1F22</item>
        <item name="android:colorPrimaryDark">#1E1F22</item>
        <item name="android:colorAccent">#4A90E2</item>
        <item name="android:colorBackground">#1E1F22</item>
        <item name="android:colorBackgroundFloating">#2B2D31</item>
        <item name="android:textColorPrimary">#F2F3F5</item>
        <item name="android:textColorSecondary">#B5BAC1</item>
        <item name="android:textColorHint">#B5BAC1</item>
        <item name="android:windowBackground">#1E1F22</item>
        <item name="android:statusBarColor">#1E1F22</item>
        <item name="android:navigationBarColor">#1E1F22</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:actionBarStyle">@style/IlsBar.Dark</item>
        <item name="android:actionMenuTextColor">#F2F3F5</item>
        <item name="android:alertDialogTheme">@style/IlsDialog.Dark</item>
        <item name="android:popupMenuStyle">@style/IlsPopup.Dark</item>
        <item name="android:actionOverflowMenuStyle">@style/IlsOverflow.Dark</item>
        <item name="android:textAppearanceLargePopupMenu">@style/IlsPopupText.Dark</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/IlsPopupText.Dark</item>
    </style>

    <style name="IlsBar.Light" parent="@android:style/Widget.Material.Light.ActionBar.Solid">
        <item name="android:background">#FFFFFF</item>
        <item name="android:titleTextStyle">@style/IlsBarTitle.Light</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="IlsBarTitle.Light" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">#1B1F24</item>
    </style>

    <style name="IlsBar.Dark" parent="@android:style/Widget.Material.ActionBar.Solid">
        <item name="android:background">#1E1F22</item>
        <item name="android:titleTextStyle">@style/IlsBarTitle.Dark</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="IlsBarTitle.Dark" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">#F2F3F5</item>
    </style>

    <style name="IlsDialog.Light" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#1E6FD9</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:textColorPrimary">#1B1F24</item>
        <item name="android:textColorSecondary">#5E6A75</item>
        <item name="android:textColorHint">#5E6A75</item>
        <item name="android:textColorAlertDialogListItem">#1B1F24</item>
    </style>

    <style name="IlsDialog.Dark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#4A90E2</item>
        <item name="android:colorBackground">#2B2D31</item>
        <item name="android:colorBackgroundFloating">#2B2D31</item>
        <item name="android:textColorPrimary">#F2F3F5</item>
        <item name="android:textColorSecondary">#B5BAC1</item>
        <item name="android:textColorHint">#B5BAC1</item>
        <item name="android:textColorAlertDialogListItem">#F2F3F5</item>
    </style>

    <style name="IlsPopupText.Light" parent="@android:style/TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:textColor">#1B1F24</item>
    </style>

    <style name="IlsPopupText.Dark" parent="@android:style/TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:textColor">#F2F3F5</item>
    </style>

    <style name="IlsPopup.Light" parent="@android:style/Widget.Material.Light.PopupMenu">
        <item name="android:popupBackground">#FFFFFF</item>
    </style>

    <style name="IlsOverflow.Light" parent="@android:style/Widget.Material.Light.PopupMenu.Overflow">
        <item name="android:popupBackground">#FFFFFF</item>
    </style>

    <style name="IlsPopup.Dark" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">#2B2D31</item>
    </style>

    <style name="IlsOverflow.Dark" parent="@android:style/Widget.Material.PopupMenu.Overflow">
        <item name="android:popupBackground">#2B2D31</item>
    </style>
</resources>
